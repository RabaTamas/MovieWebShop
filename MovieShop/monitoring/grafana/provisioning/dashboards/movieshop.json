{
  "uid": "movieshop-overview",
  "title": "MovieShop — mikroszervíz áttekintés",
  "description": "Válaszidő, átbocsátás, hibaarány és erőforrás-használat service-enként. A lekérdezések a prometheus-net által kiadott metrikanevekre épülnek.",
  "tags": ["movieshop", "microservices"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Válaszidő p95 service-enként",
      "description": "A kérések 95%-a ennél gyorsabb. Terhelés alatt itt látszik, melyik service lassul be először.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "movieshop-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kérés / másodperc service-enként",
      "description": "Átbocsátás. Összevetve a válaszidővel megmutatja, hol van a szűk keresztmetszet.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "movieshop-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_requests_received_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hibaarány (5xx válaszok aránya)",
      "description": "A szerverhibák aránya az összes kéréshez képest. Terheléstesztnél ez mutatja, mikor kezd eltörni a rendszer.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "movieshop-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_requests_received_total{code=~\"5..\"}[1m])) / clamp_min(sum by (service) (rate(http_requests_received_total[1m])), 0.001)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Egyidejűleg feldolgozott kérések",
      "description": "Ha ez folyamatosan nő, a service nem tudja tartani a bejövő tempót.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "movieshop-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (http_requests_in_progress)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Processzorhasználat service-enként",
      "description": "Magban kifejezve (1 = egy teljes processzormag).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "movieshop-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(process_cpu_seconds_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memóriahasználat service-enként",
      "description": "A folyamat által használt memória (working set).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "movieshop-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (process_working_set_bytes)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Konténerek processzorhasználata (cAdvisor)",
      "description": "Alkalmazásfüggetlen mérés: itt az adatbázis, a RabbitMQ és az Elasticsearch is látszik.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "movieshop-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 6 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"movieshop-ms-.+\"}[1m]))",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}
