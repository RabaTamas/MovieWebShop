  <ItemGroup>
    <PackageReference Include="Ocelot" Version="25.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MovieShop.ServiceDefaults\MovieShop.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
